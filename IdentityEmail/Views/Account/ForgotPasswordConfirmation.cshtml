@{
    Layout = null;
}
<!DOCTYPE html>
<html class="light" lang="en" style="">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Şifre Sıfırlama | Yudi</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <script id="tailwind-config">
        tailwind.config = {
        darkMode: "class",
        theme: { extend: { "colors": { "primary": "#7f30c5", "secondary": "#af0093", "on-surface": "#1f1a22", "on-surface-variant": "#4c4353", "tertiary-fixed": "#ffdf99", "tertiary": "#745800", "outline-variant": "#cfc2d5" }, "spacing": { "sm": "12px", "xs": "4px", "md": "24px", "lg": "40px", "base": "8px", "xl": "64px", "gutter": "24px" }, "fontSize": { "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600" }], "body-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }], "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600" }] } } }
        }
    </script>
    <style>
        body {
        font-family: 'Inter', sans-serif;
        background-color: #f5f7fb;
        }

        .bg-mesh {
        background-image: radial-gradient(at 0% 0%, rgba(255, 79, 216, 0.15) 0px, transparent 50%), radial-gradient(at 100% 100%, rgba(183, 108, 255, 0.15) 0px, transparent 50%);
        }

        .auth-card {
        backdrop-filter: blur(20px);
        background: rgba(255, 255, 255, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.5);
        }

        .primary-gradient {
        background: linear-gradient(135deg, #ff4fd8 0%, #b76cff 100%);
        }

        .fade-in {
        animation: fadeIn 0.8s ease-out forwards;
        }

        @@keyframes fadeIn {
        from {
        opacity: 0;
        transform: translateY(10px);
        }

        to {
        opacity: 1;
        transform: translateY(0);
        }
        }

        .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>
<body class="bg-mesh min-h-screen flex flex-col items-center justify-center p-gutter">
    <main class="w-full max-w-[440px] z-10 fade-in">
        <div class="flex flex-col items-center mb-lg">
            <div class="w-16 h-16 rounded-2xl primary-gradient flex items-center justify-center shadow-lg mb-md">
                <span class="material-symbols-outlined text-white text-[32px]" style="font-variation-settings: 'FILL' 1;">auto_awesome</span>
            </div>
            <h1 class="font-headline-md text-headline-md text-primary tracking-tight">Yudi Kurumsal A.Ş</h1>
        </div>

        <div class="auth-card rounded-3xl p-lg shadow-[0px_4px_20px_rgba(0,0,0,0.03)] text-center space-y-md">
            <div class="w-16 h-16 rounded-full bg-tertiary-fixed text-tertiary mx-auto flex items-center justify-center">
                <span class="material-symbols-outlined text-[32px]">mark_email_read</span>
            </div>
            <h2 class="font-headline-lg text-headline-lg text-on-surface">E-postanızı kontrol edin</h2>
            <p class="font-body-md text-body-md text-on-surface-variant">
                Şifre sıfırlama bağlantısı e-posta adresinize gönderildi. Kısa süre içinde ulaşacaktır.
            </p>
            <div class="pt-md border-t border-white/30">
                <a class="font-label-md text-label-md text-primary hover:text-secondary transition-colors inline-flex items-center gap-xs" href="/Account/Login">
                    <span class="material-symbols-outlined text-sm">keyboard_backspace</span>
                    Giriş Sayfasına Dön
                </a>
            </div>
        </div>

        <div class="fixed -bottom-24 -left-24 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>
        <div class="fixed -top-24 -right-24 w-96 h-96 bg-secondary/5 rounded-full blur-3xl pointer-events-none"></div>
    </main>

    <footer class="mt-xl text-center fade-in">
        <p class="font-label-md text-label-md text-outline-variant">© @DateTime.Now.Year Yudi Kurumsal. Tüm hakları saklıdır.</p>
        <div class="flex gap-md justify-center mt-sm">
            <a class="font-label-md text-label-md text-outline-variant hover:text-primary transition-colors" href="#">Gizlilik Politikası</a>
            <a class="font-label-md text-label-md text-outline-variant hover:text-primary transition-colors" href="#">Hizmet Şartları</a>
        </div>
    </footer>
</body>
</html>