    <style>
        .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.03);
        }

        .primary-gradient {
        background: linear-gradient(135deg, #7f30c5 0%, #af0093 100%);
        }

        .bg-mesh {
        background-color: #fff7fe;
        background-image: radial-gradient(at 0% 0%, rgba(127, 48, 197, 0.15) 0px, transparent 50%), radial-gradient(at 100% 0%, rgba(175, 0, 147, 0.1) 0px, transparent 50%), radial-gradient(at 100% 100%, rgba(127, 48, 197, 0.05) 0px, transparent 50%), radial-gradient(at 0% 100%, rgba(175, 0, 147, 0.1) 0px, transparent 50%);
        }

        .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>
<body class="bg-mesh min-h-screen flex flex-col font-body-lg text-on-background selection:bg-primary/20">
    <!-- TopNavBar -->
    <nav class="fixed top-0 left-0 w-full z-50 h-[72px] flex items-center justify-between px-md max-w-container-max mx-auto bg-white/70 dark:bg-surface/70 backdrop-blur-xl border-b border-white/50 dark:border-outline-variant/20 shadow-[0px_4px_20px_rgba(0,0,0,0.03)]">
        <div class="flex items-center gap-sm">
            <span class="font-headline-md text-headline-md font-bold text-primary dark:text-primary-fixed-dim">Yudi Kurumsal A.Ş</span>
        </div>
        <div class="flex items-center gap-md">
            <a class="font-body-lg text-body-lg text-primary dark:text-primary-fixed-dim hover:opacity-80 transition-opacity" href="/Account/Login">Login</a>
        </div>
    </nav>
    <!-- Main Content -->
    <main class="flex-grow flex items-center justify-center pt-[72px] px-md">
        <div class="glass-card w-full max-w-[480px] p-lg md:p-xl rounded-xl text-center flex flex-col items-center animate-in fade-in zoom-in duration-700">
            <!-- Icon/Illustration -->
            <div class="w-24 h-24 mb-md rounded-full bg-surface-container-low flex items-center justify-center relative group">
                <div class="absolute inset-0 primary-gradient opacity-10 rounded-full group-hover:opacity-20 transition-opacity duration-300"></div>
                <span class="material-symbols-outlined text-[48px] text-primary" data-icon="verified_user">verified_user</span>
            </div>
            <!-- Content -->
            <h1 class="font-headline-lg text-headline-lg text-on-surface mb-sm">Çıkış Yapıldı</h1>
            <p class="font-body-lg text-body-lg text-on-surface-variant mb-lg">
                Yudi Kurumsal A.Ş'i kullandığınız için teşekkür ederiz. Oturumunuz güvenli bir şekilde sonlandırıldı.
            </p>
            <!-- Actions -->
            <div class="w-full space-y-md">
                <button class="w-full primary-gradient text-white py-sm px-md rounded-lg font-title-lg text-title-lg shadow-lg hover:shadow-xl hover:scale-[1.02] active:scale-95 transition-all duration-200">
                    Tekrar Giriş Yap
                </button>
                <a class="inline-block font-label-md text-label-md text-primary dark:text-primary-fixed-dim hover:text-secondary transition-colors duration-200 uppercase tracking-wider" href="/Account/Login">
                   Ana Sayfaya Dön
                </a>
            </div>
            <!-- Aesthetic Divider -->
            <div class="w-16 h-1 primary-gradient rounded-full mt-xl opacity-20"></div>
        </div>
    </main>
    <!-- Footer -->
    <footer class="bg-surface border-t border-outline-variant/20 py-md px-md">
        <div class="max-w-container-max mx-auto flex flex-col md:flex-row justify-between items-center w-full gap-base">
            <div class="font-title-lg text-title-lg font-bold text-on-surface"><span style="color: rgb(127, 48, 197); font-size: 24px; letter-spacing: -0.6px; text-align: center; background-color: rgb(245, 247, 251);">Yudi</span></div>
            <div class="flex gap-md">
                <a class="font-label-md text-label-md text-on-surface-variant hover:text-secondary transition-all opacity-80 hover:opacity-100" href="#">Gizlilik Politikası</a>
                <a class="font-label-md text-label-md text-on-surface-variant hover:text-secondary transition-all opacity-80 hover:opacity-100" href="#">Hizmet Şartları</a>

            </div>
            <p class="font-label-md text-label-md text-on-surface-variant">
                © @DateTime.Now.Year Yudi Kurumsal. Tüm hakları saklıdır.
            </p>
        </div>
    </footer>
    <script>
        // Micro-interaction for the logout icon
        const iconContainer = document.querySelector('.group');
        iconContainer.addEventListener('mouseenter', () => {
        const icon = iconContainer.querySelector('.material-symbols-outlined');
        icon.style.transform = 'scale(1.1) rotate(5deg)';
        icon.style.transition = 'transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)';
        });
        iconContainer.addEventListener('mouseleave', () => {
        const icon = iconContainer.querySelector('.material-symbols-outlined');
        icon.style.transform = 'scale(1) rotate(0deg)';
        });
    </script>
</body></html>