@model IdentityEmail.Dtos.ResetPasswordDto;
@{
    Layout = null;
}

<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Reset Password | Ethereal Enterprise</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <script id="tailwind-config">
        tailwind.config = {
        darkMode: "class",
        theme: {
        extend: {
        "colors": {
        "tertiary-fixed-dim": "#f1c042",
        "tertiary": "#745800",
        "secondary-fixed-dim": "#ffade3",
        "primary-container": "#994ee0",
        "primary-fixed": "#f0dbff",
        "on-surface": "#1f1a22",
        "on-secondary-fixed-variant": "#860070",
        "on-primary-fixed-variant": "#680bae",
        "on-tertiary-fixed": "#251a00",
        "on-primary": "#ffffff",
        "on-secondary-container": "#5f004f",
        "on-error-container": "#93000a",
        "error-container": "#ffdad6",
        "surface-container-low": "#fbf0fd",
        "on-tertiary": "#ffffff",
        "on-primary-container": "#fffbff",
        "error": "#ba1a1a",
        "primary-fixed-dim": "#ddb7ff",
        "inverse-on-surface": "#f8edfa",
        "surface-container-lowest": "#ffffff",
        "on-primary-fixed": "#2c0050",
        "on-tertiary-fixed-variant": "#5a4300",
        "inverse-primary": "#ddb7ff",
        "surface-container-high": "#efe5f2",
        "outline": "#7e7384",
        "on-tertiary-container": "#fffbff",
        "tertiary-fixed": "#ffdf99",
        "secondary": "#af0093",
        "background": "#fff7fe",
        "on-surface-variant": "#4c4353",
        "primary": "#7f30c5",
        "surface-bright": "#fff7fe",
        "on-error": "#ffffff",
        "on-background": "#1f1a22",
        "surface-container-highest": "#e9dfec",
        "on-secondary": "#ffffff",
        "surface-variant": "#e9dfec",
        "tertiary-container": "#936f00",
        "secondary-container": "#fe4ed7",
        "on-secondary-fixed": "#3a0030",
        "outline-variant": "#cfc2d5",
        "inverse-surface": "#342e38",
        "surface-container": "#f5eaf7",
        "surface": "#fff7fe",
        "surface-tint": "#8134c8",
        "surface-dim": "#e1d7e3",
        "secondary-fixed": "#ffd8ee"
        },
        "spacing": {
        "xs": "4px",
        "sm": "12px",
        "base": "8px",
        "lg": "40px",
        "gutter": "24px",
        "container-max": "1280px",
        "md": "24px",
        "xl": "64px"
        },
        "fontFamily": {
        "display-lg": ["Inter"],
        "body-lg": ["Inter"],
        "headline-md": ["Inter"],
        "headline-lg": ["Inter"],
        "label-md": ["Inter"],
        "body-md": ["Inter"],
        "title-lg": ["Inter"]
        },
        "fontSize": {
        "display-lg": ["48px", { "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
        "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
        "headline-md": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
        "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600" }],
        "body-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
        "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
        "title-lg": ["20px", { "lineHeight": "28px", "fontWeight": "500" }]
        }
        }
        }
        }
    </script>
    <style>
        body {
        font-family: 'Inter', sans-serif;
        background-color: #fff7fe;
        overflow: hidden;
        }

        .glass-morphism {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-top: 1px solid rgba(255, 255, 255, 0.5);
        box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.03);
        }

        .ethereal-gradient-bg {
        background: radial-gradient(circle at 0% 0%, #fff7fe 0%, #f5eaf7 50%, #f0dbff 100%);
        position: fixed;
        inset: 0;
        z-index: -1;
        }

        .floating-blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        z-index: -1;
        opacity: 0.4;
        animation: float 20s infinite alternate ease-in-out;
        }

        @@keyframes float {
        0% {
        transform: translate(0, 0) scale(1);
        }

        100% {
        transform: translate(100px, 50px) scale(1.1);
        }
        }

        .primary-gradient {
        background: linear-gradient(135deg, #7f30c5 0%, #af0093 100%);
        transition: all 0.3s ease;
        }

        .primary-gradient:hover {
        opacity: 0.9;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(127, 48, 197, 0.3);
        }

        .input-glow:focus {
        box-shadow: 0 0 0 4px rgba(127, 48, 197, 0.1);
        border-color: #7f30c5;
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-gutter">
    <!-- Atmospheric Background Elements -->
    <div class="ethereal-gradient-bg"></div>
    <div class="floating-blob bg-primary-container w-[500px] h-[500px] -top-48 -left-48"></div>
    <div class="floating-blob bg-secondary-container w-[400px] h-[400px] -bottom-24 -right-24" style="animation-delay: -5s;"></div>
    <!-- Main Content Canvas -->
    <main class="w-full max-w-md animate-in fade-in slide-in-from-bottom-4 duration-1000">
        <!-- Reset Password Card -->
        <div class="glass-morphism rounded-xl p-xl flex flex-col items-center">
            <!-- Brand Logo Anchor -->
            <div class="mb-lg text-center">
                <span class="font-headline-md text-headline-md font-bold text-primary tracking-tight block">Yudi Kurumsal A.Ş</span>
            </div>
            <!-- Header Section -->
            <div class="text-center mb-lg">
                <h1 class="font-headline-lg text-headline-lg text-on-surface mb-xs">Şifreyi Sıfırla</h1>
                <p class="font-body-md text-body-md text-on-surface-variant">Lütfen yeni şifrenizi aşağıya girin.</p>
            </div>
            <!-- Reset Form -->
            <form class="w-full space-y-md" id="resetForm" onsubmit="return checkPasswords()" method="post" action="/Account/ResetPassword">
                <input type="hidden" name="Token" value="@Model.Token" />
                <input type="hidden" name="Email" value="@Model.Email" />
                <!-- New Password Field -->
                <div class="space-y-base">
                    <label class="font-label-md text-label-md text-on-surface-variant block uppercase tracking-wider ml-1" asp-for="NewPassword">Yeni Şifre</label>
                    <div class="relative group">
                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors">lock</span>
                        <input class="w-full pl-12 pr-12 py-4 bg-[#eceef3] border-transparent rounded-xl font-body-md text-body-md text-on-surface outline-none transition-all input-glow focus:bg-white" id="password" name="NewPassword" placeholder="••••••••" required="" type="password">
                        <button class="absolute right-4 top-1/2 -translate-y-1/2 text-outline hover:text-primary transition-colors" onclick="togglePassword('password')" type="button">
                            <span class="material-symbols-outlined" id="eye-password">visibility</span>
                        </button>
                    </div>
                </div>
                <!-- Confirm New Password Field -->
                <div class="space-y-base">
                    <label class="font-label-md text-label-md text-on-surface-variant block uppercase tracking-wider ml-1" asp-for="ConfirmPassword">Yeni Şifre (Tekrar)</label>
                    <div class="relative group">
                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors">lock_reset</span>
                        <input class="w-full pl-12 pr-12 py-4 bg-[#eceef3] border-transparent rounded-xl font-body-md text-body-md text-on-surface outline-none transition-all input-glow focus:bg-white" id="confirm_password" name="ConfirmPassword" placeholder="••••••••" required="" type="password">
                        <button class="absolute right-4 top-1/2 -translate-y-1/2 text-outline hover:text-primary transition-colors" onclick="togglePassword('confirm_password')" type="button">
                            <span class="material-symbols-outlined" id="eye-confirm_password">visibility</span>
                        </button>
                    </div>
                </div>
                <!-- Primary Action Button -->
                <button class="w-full primary-gradient text-on-primary font-title-lg text-title-lg py-4 rounded-xl shadow-lg active:scale-95 transition-all mt-base" type="submit">
                    Şifreyi Sıfırla
                </button>
            </form>
            <!-- Navigation Link -->
            <div class="mt-lg">
                <a class="inline-flex items-center gap-xs font-label-md text-label-md text-on-surface-variant hover:text-primary transition-colors group" href="/Account/Login">
                    <span class="material-symbols-outlined text-[18px] group-hover:-translate-x-1 transition-transform">arrow_back</span>
                    Giriş Sayfasına Dön
                </a>
            </div>
        </div>
        <!-- Success Toast (Hidden by default) -->
        <div class="fixed bottom-lg left-1/2 -translate-x-1/2 glass-morphism px-md py-sm rounded-full border border-primary/20 opacity-0 pointer-events-none transition-all duration-500 transform translate-y-4" id="successToast">
            <div class="flex items-center gap-sm">
                <div class="w-8 h-8 rounded-full bg-primary-container flex items-center justify-center">
                    <span class="material-symbols-outlined text-on-primary-container text-[20px]">check</span>
                </div>
                <span class="font-body-md text-body-md text-on-surface">Şifre başarıyla güncellendi</span>
            </div>
        </div>
    </main>
    <script>
        function togglePassword(id) {
        const input = document.getElementById(id);
        const icon = document.getElementById('eye-' + id);
        if (input.type === 'password') {
        input.type = 'text';
        icon.innerText = 'visibility_off';
        } else {
        input.type = 'password';
        icon.innerText = 'visibility';
        }
        }

        function checkPasswords() {
        const pass = document.getElementById('password').value;
        const confirm = document.getElementById('confirm_password').value;
        if (pass !== confirm) {
        alert("Şifreler eşleşmiyor");
        return false;
        }
        return true;
        }

      
    </script>


</body></html>