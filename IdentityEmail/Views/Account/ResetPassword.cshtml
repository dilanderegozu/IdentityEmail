<body class="font-body-md text-on-surface selection:bg-primary-fixed">

    ```
    <main class="flex-grow flex items-center justify-center px-gutter py-xl">
        <div class="w-full max-w-md">

            <!-- Kart -->
            <div class="glass-card rounded-[32px] p-lg md:p-xl text-center space-y-md">

                <!-- Başarı İkonu -->
                <div class="flex justify-center">
                    <div class="brand-gradient w-20 h-20 rounded-full flex items-center justify-center shadow-lg shadow-primary/20">
                        <span class="material-symbols-outlined text-white text-[40px]"
                              style="font-variation-settings: 'FILL' 1;">
                            mark_email_read
                        </span>
                    </div>
                </div>

                <!-- İçerik -->
                <div class="space-y-sm">
                    <h1 class="font-headline-lg text-headline-lg text-on-surface">
                        E-postanızı Kontrol Edin
                    </h1>

                    <p class="font-body-lg text-body-lg text-on-surface-variant max-w-[280px] mx-auto">
                        Şifre sıfırlama bağlantısı e-posta adresinize gönderildi.
                        Şifrenizi sıfırlamak için lütfen e-postadaki talimatları takip edin.
                    </p>
                </div>

                <!-- Butonlar -->
                <div class="pt-base space-y-sm">

                    <a class="brand-gradient block w-full py-4 rounded-full font-label-md text-label-md text-white text-center shadow-md hover:shadow-lg active:scale-[0.98] transition-all"
                       href="/login">
                        Giriş Sayfasına Dön
                    </a>

                    <button id="resendBtn"
                            class="w-full py-4 rounded-full font-label-md text-label-md text-primary bg-surface-container-low hover:bg-surface-container transition-colors active:scale-[0.98]">
                        E-postayı Tekrar Gönder
                    </button>

                </div>

                <!-- Geri Dön -->
                <div class="pt-base">
                    <a class="font-label-md text-label-md text-on-surface-variant hover:text-primary transition-colors flex items-center justify-center gap-xs"
                       href="/Account/ForgotPassword">

                        <span class="material-symbols-outlined text-[18px]">
                            arrow_back
                        </span>

                        Şifremi Unuttum Sayfasına Dön
                    </a>
                </div>

            </div>

            <!-- Alt Dekor -->
            <div class="mt-lg flex justify-center opacity-50">
                <div class="flex gap-2">
                    <div class="w-2 h-2 rounded-full bg-primary/20"></div>
                    <div class="w-8 h-2 rounded-full brand-gradient"></div>
                    <div class="w-2 h-2 rounded-full bg-primary/20"></div>
                </div>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="mt-xl text-center">
        <p class="font-label-md text-label-md text-outline-variant">
            © @DateTime.Now.Year Yudi Kurumsal. Tüm hakları saklıdır.
        </p>

        <div class="flex gap-md justify-center mt-sm">

            <a class="font-label-md text-label-md text-outline-variant hover:text-primary transition-colors"
               href="#">
                Gizlilik Politikası
            </a>

            <a class="font-label-md text-label-md text-outline-variant hover:text-primary transition-colors"
               href="#">
                Kullanım Şartları
            </a>

        </div>
    </footer>

    <script>
        const resendBtn = document.getElementById("resendBtn");

        resendBtn.addEventListener("click", () => {

        const originalText = resendBtn.innerText;

        resendBtn.innerText = "E-posta Gönderildi!";
        resendBtn.classList.add("text-secondary");

        resendBtn.disabled = true;

        setTimeout(() => {

        resendBtn.innerText = originalText;
        resendBtn.classList.remove("text-secondary");

        resendBtn.disabled = false;

        }, 3000);
        });
    </script>
    ```

