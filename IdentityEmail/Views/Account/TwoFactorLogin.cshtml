@{
    Layout = null;
}

<!DOCTYPE html>

<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Two-Step Verification | Ethereal Enterprise</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
        darkMode: "class",
        theme: {
        extend: {
        "colors": {
        "secondary-container": "#fe4ed7",
        "surface-container-highest": "#e9dfec",
        "secondary-fixed-dim": "#ffade3",
        "primary-container": "#994ee0",
        "primary-fixed": "#f0dbff",
        "on-primary-fixed-variant": "#680bae",
        "inverse-on-surface": "#f8edfa",
        "on-tertiary": "#ffffff",
        "error-container": "#ffdad6",
        "surface-dim": "#e1d7e3",
        "on-secondary-fixed": "#3a0030",
        "on-primary": "#ffffff",
        "error": "#ba1a1a",
        "on-secondary-fixed-variant": "#860070",
        "outline-variant": "#cfc2d5",
        "on-error": "#ffffff",
        "on-surface-variant": "#4c4353",
        "background": "#fff7fe",
        "primary": "#7f30c5",
        "on-primary-container": "#fffbff",
        "inverse-surface": "#342e38",
        "surface": "#fff7fe",
        "surface-bright": "#fff7fe",
        "on-secondary": "#ffffff",
        "inverse-primary": "#ddb7ff",
        "on-surface": "#1f1a22",
        "secondary-fixed": "#ffd8ee",
        "surface-container-lowest": "#ffffff",
        "surface-variant": "#e9dfec",
        "on-tertiary-fixed": "#251a00",
        "surface-container-high": "#efe5f2",
        "surface-container-low": "#fbf0fd",
        "on-background": "#1f1a22",
        "primary-fixed-dim": "#ddb7ff",
        "tertiary": "#745800",
        "tertiary-fixed": "#ffdf99",
        "on-secondary-container": "#5f004f",
        "tertiary-container": "#936f00",
        "tertiary-fixed-dim": "#f1c042",
        "on-primary-fixed": "#2c0050",
        "on-error-container": "#93000a",
        "surface-container": "#f5eaf7",
        "outline": "#7e7384",
        "on-tertiary-fixed-variant": "#5a4300",
        "surface-tint": "#8134c8",
        "secondary": "#af0093",
        "on-tertiary-container": "#fffbff"
        },
        "borderRadius": {
        "DEFAULT": "0.25rem",
        "lg": "0.5rem",
        "xl": "0.75rem",
        "full": "9999px"
        },
        "spacing": {
        "xl": "64px",
        "md": "24px",
        "container-max": "1280px",
        "sm": "12px",
        "gutter": "24px",
        "lg": "40px",
        "xs": "4px",
        "base": "8px"
        },
        "fontFamily": {
        "title-lg": ["Inter"],
        "headline-md": ["Inter"],
        "label-md": ["Inter"],
        "headline-lg-mobile": ["Inter"],
        "body-lg": ["Inter"],
        "display-lg": ["Inter"],
        "headline-lg": ["Inter"],
        "body-md": ["Inter"]
        },
        "fontSize": {
        "title-lg": ["20px", {"lineHeight": "28px", "fontWeight": "500"}],
        "headline-md": ["24px", {"lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
        "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600"}],
        "headline-lg-mobile": ["24px", {"lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
        "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
        "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
        "headline-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
        "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}]
        }
        },
        },
        }
    </script>
    <style>
        body {
        background-color: #f5f7fb;
        font-family: 'Inter', sans-serif;
        overflow-x: hidden;
        }

        .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.03);
        }

        .blob {
        position: absolute;
        width: 500px;
        height: 500px;
        filter: blur(80px);
        z-index: -1;
        opacity: 0.4;
        animation: move 20s infinite alternate ease-in-out;
        }
        @@keyframes move {
        from {
        transform: translate(-10%, -10%);
        }

        to {
        transform: translate(10%, 10%);
        }
        }

        input::-webkit-outer-spin-button,
        input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
        }

        .otp-input:focus {
        box-shadow: 0 0 0 2px #7f30c5;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">
    <!-- Atmospheric Background Blobs -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
        <div class="blob bg-primary top-[-100px] left-[-100px]"></div>
        <div class="blob bg-secondary-container bottom-[-100px] right-[-100px]" style="animation-delay: -5s;"></div>
        <div class="blob bg-tertiary-fixed-dim top-1/2 left-1/3" style="animation-delay: -10s;"></div>
    </div>
    <!-- Navigation Shell (Suppressed as per rules for transactional screen) -->
    <!-- Not rendering TopNavBar on a login/auth task-focused sub-page -->
    <main class="flex-grow flex items-center justify-center p-md">
        <div class="w-full max-w-[480px] glass-card rounded-[32px] p-xl flex flex-col items-center text-center animate-in fade-in zoom-in duration-700">
            <!-- Security Icon -->
            <div class="w-16 h-16 bg-gradient-to-br from-primary to-secondary-container rounded-2xl flex items-center justify-center mb-md shadow-lg shadow-primary/20">
                <span class="material-symbols-outlined text-white text-[32px]" style="font-variation-settings: 'FILL' 1;">
                    verified_user
                </span>
            </div>
            <!-- Heading & Subtext -->
            <h1 class="font-headline-lg text-headline-lg text-on-surface mb-xs">
                            
            </h1>
            <p class="font-body-md text-body-md text-on-surface-variant max-w-[320px] mb-lg">
                Lütfen kayıtlı cihazınıza gönderilen 6 haneli kodu girin.
            </p>
            <!-- Verification Form -->
            <form class="w-full space-y-lg" id="otp-form">
                <div class="flex justify-between gap-xs sm:gap-sm">
                    <input autocomplete="one-time-code" class="otp-input w-12 h-14 sm:w-14 sm:h-16 text-center text-headline-md font-bold bg-[#eceef3] border-none rounded-xl focus:bg-white focus:ring-primary transition-all duration-200" maxlength="1" required="" type="number" />
                    <input class="otp-input w-12 h-14 sm:w-14 sm:h-16 text-center text-headline-md font-bold bg-[#eceef3] border-none rounded-xl focus:bg-white focus:ring-primary transition-all duration-200" maxlength="1" required="" type="number" />
                    <input class="otp-input w-12 h-14 sm:w-14 sm:h-16 text-center text-headline-md font-bold bg-[#eceef3] border-none rounded-xl focus:bg-white focus:ring-primary transition-all duration-200" maxlength="1" required="" type="number" />
                    <input class="otp-input w-12 h-14 sm:w-14 sm:h-16 text-center text-headline-md font-bold bg-[#eceef3] border-none rounded-xl focus:bg-white focus:ring-primary transition-all duration-200" maxlength="1" required="" type="number" />
                    <input class="otp-input w-12 h-14 sm:w-14 sm:h-16 text-center text-headline-md font-bold bg-[#eceef3] border-none rounded-xl focus:bg-white focus:ring-primary transition-all duration-200" maxlength="1" required="" type="number" />
                    <input class="otp-input w-12 h-14 sm:w-14 sm:h-16 text-center text-headline-md font-bold bg-[#eceef3] border-none rounded-xl focus:bg-white focus:ring-primary transition-all duration-200" maxlength="1" required="" type="number" />
                </div>
                <!-- Primary Action -->
                <button class="w-full py-md px-lg bg-gradient-to-r from-primary to-secondary-container text-white font-label-md text-label-md uppercase tracking-widest rounded-full shadow-lg shadow-primary/25 hover:opacity-90 active:scale-[0.98] transition-all duration-200" type="submit">
                    Doğrula
                </button>
            </form>
            <!-- Links Area -->
            <div class="mt-lg space-y-sm">
                <div class="flex items-center justify-center gap-base">
                    <span class="font-body-md text-body-md text-on-surface-variant">Kod almadınız mı?</span>
                    <button class="font-label-md text-label-md text-primary font-bold hover:underline transition-all" id="resend-btn">
                       Kod Gönder
                    </button>
                </div>
                <div class="pt-base">
                    <a class="font-label-md text-label-md text-outline hover:text-primary transition-colors inline-flex items-center gap-xs" href="#">
                        <span class="material-symbols-outlined text-[16px]">shuffle</span>
                        Alternative method
                    </a>
                </div>
            </div>
        </div>
    </main>
    <!-- Footer Component Integration (Shared) -->
    <footer class="bg-surface border-t border-outline-variant/20 py-md px-md">
        <div class="max-w-container-max mx-auto flex flex-col md:flex-row justify-between items-center w-full gap-base">
            <div class="font-title-lg text-title-lg font-bold text-on-surface"><span style="color: rgb(127, 48, 197); font-size: 24px; letter-spacing: -0.6px; text-align: center; background-color: rgb(245, 247, 251);">Yudi</span></div>
            <div class="flex gap-md">
                <a class="font-label-md text-label-md text-on-surface-variant hover:text-secondary transition-all opacity-80 hover:opacity-100" href="#">Gizlilik Politikası</a>
                <a class="font-label-md text-label-md text-on-surface-variant hover:text-secondary transition-all opacity-80 hover:opacity-100" href="#">Hizmet Şartları</a>

            </div>
            <p class="font-label-md text-label-md text-on-surface-variant">
                © @DateTime.Now.Year Yudi Kurumsal. Tüm hakları saklıdır.
            </p>
        </div>
    </footer>
    <script>
        // Micro-interactions for OTP Inputs
        const inputs = document.querySelectorAll('.otp-input');

        inputs.forEach((input, index) => {
        // Handle number input and focus shifting
        input.addEventListener('input', (e) => {
        if (e.target.value.length > 1) {
        e.target.value = e.target.value.slice(0, 1);
        }
        if (e.target.value && index < inputs.length - 1) {
        inputs[index + 1].focus();
        }
        });

        // Handle backspace
        input.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !e.target.value && index > 0) {
        inputs[index - 1].focus();
        }
        });
        });

        // Form submission effect
        document.getElementById('otp-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const btn = e.target.querySelector('button');
        const originalText = btn.innerText;
        btn.innerHTML = '<span class="material-symbols-outlined animate-spin">sync</span>';
        btn.disabled = true;

        setTimeout(() => {
        btn.innerHTML = 'Success <span class="material-symbols-outlined ml-2">check_circle</span>';
        btn.classList.replace('from-primary', 'from-emerald-500');
        btn.classList.replace('to-secondary-container', 'to-teal-500');
        }, 1500);
        });

        // Resend code timer logic
        const resendBtn = document.getElementById('resend-btn');
        let timeLeft = 30;
        let isResending = false;

        resendBtn.addEventListener('click', () => {
        if (isResending) return;
        isResending = true;
        resendBtn.classList.add('opacity-50', 'cursor-not-allowed');

        const timer = setInterval(() => {
        resendBtn.innerText = `Wait ${timeLeft}s`;
        timeLeft--;
        if (timeLeft < 0) {
        clearInterval(timer);
        resendBtn.innerText = 'Resend Code';
        resendBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        timeLeft = 30;
        isResending = false;
        }
        }, 1000);
        });
    </script>
</body></html>