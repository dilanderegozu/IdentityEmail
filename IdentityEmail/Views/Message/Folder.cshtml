@model List<IdentityEmail.Entities.UserMessage>
@{
    ViewData["Title"] = ViewBag.FolderTitle;
    Layout = "_MessageLayout";
}

<main class="flex-1 flex flex-col bg-surface overflow-visible relative">
    <div class="h-16 flex items-center justify-between px-md border-b border-outline-variant/20 bg-white/40 glass">
        <div class="flex items-center gap-md">
            <h2 class="font-headline-md text-headline-md text-on-surface-variant">@ViewBag.FolderTitle</h2>
            <div class="flex items-center gap-xs ml-md">
                <button id="archiveBtn" onclick="bulkArchive()" disabled class="p-sm text-outline-variant rounded-lg transition-all cursor-not-allowed" title="Arşivle">
                    <span class="material-symbols-outlined text-[20px]">archive</span>
                </button>
                <button id="reportBtn" disabled class="p-sm text-outline-variant rounded-lg transition-all cursor-not-allowed" title="Bildir">
                    <span class="material-symbols-outlined text-[20px]">report</span>
                </button>
                <button id="deleteBtn" onclick="bulkDelete()" disabled class="p-sm text-outline-variant rounded-lg transition-all cursor-not-allowed" title="Sil">
                    <span class="material-symbols-outlined text-[20px]">delete</span>
                </button>
                <span id="selectionCount" class="text-xs text-outline ml-xs"></span>
            </div>
        </div>
        <div class="flex items-center gap-sm">
            <div class="relative z-[9999]">
                <button id="filterBtn" class="flex items-center gap-xs px-md py-xs bg-surface-container-high text-on-surface font-label-md text-label-md rounded-lg hover:bg-surface-container-highest transition-all">
                    <span class="material-symbols-outlined text-[18px]">sort</span>
                    Filtrele
                </button>

                <div id="filterDropdown"
                     class="hidden fixed top-24 right-10 w-80 bg-white rounded-2xl border border-gray-200 shadow-2xl p-5 z-[99999]">

                    

                    <h3 class="font-semibold text-gray-800 mb-4">
                        Mesaj Filtreleri
                    </h3>

                    <div class="mb-5">
                        <p class="text-xs font-semibold text-gray-500 uppercase mb-3">
                            Durum
                        </p>

                        <div class="space-y-2">
                            <label class="flex items-center gap-3 p-2 rounded-lg hover:bg-gray-100 cursor-pointer">
                                <input type="radio" name="isRead" value="" checked>
                                <span>Tümü</span>
                            </label>

                            <label class="flex items-center gap-3 p-2 rounded-lg hover:bg-gray-100 cursor-pointer">
                                <input type="radio" name="isRead" value="false">
                                <span>Okunmamış</span>
                            </label>

                            <label class="flex items-center gap-3 p-2 rounded-lg hover:bg-gray-100 cursor-pointer">
                                <input type="radio" name="isRead" value="true">
                                <span>Okunmuş</span>
                            </label>
                        </div>
                    </div>

                    <div class="border-t pt-4 mb-5">
                        <p class="text-xs font-semibold text-gray-500 uppercase mb-3">
                            Yıldız
                        </p>

                        <label class="flex items-center gap-3 p-2 rounded-lg hover:bg-gray-100 cursor-pointer">
                            <input type="checkbox" id="starredFilter">
                            <span>Sadece yıldızlı</span>
                        </label>
                    </div>

                    <div class="border-t pt-4 mb-5">
                        <p class="text-xs font-semibold text-gray-500 uppercase mb-3">
                            Kategori
                        </p>

                        <select id="categoryFilter"
                                class="w-full border border-gray-300 rounded-lg px-3 py-2">
                            <option value="">Tümü</option>

                            @if (ViewBag.Categories != null)
                            {
                                @foreach (var cat in ViewBag.Categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <button onclick="applyFilters()"
                            class="w-full py-3 bg-primary text-white rounded-xl font-semibold">
                        Filtreleri Uygula
                    </button>
                </div>
            </div>

            <div class="flex items-center text-on-surface-variant text-label-md px-sm">@Model.Count mesaj</div>
        </div>
    </div>

    <div class="flex-1 overflow-y-auto p-md space-y-sm">
        @if (!Model.Any())
        {
            <div class="flex flex-col items-center justify-center h-full py-xl text-center">
                <div class="w-24 h-24 mb-lg rounded-full bg-surface-container flex items-center justify-center">
                    <span class="material-symbols-outlined text-[48px] text-outline">inbox</span>
                </div>
                <h3 class="font-headline-md text-on-surface-variant mb-xs">@ViewBag.FolderTitle boş</h3>
                <p class="text-outline font-body-md max-w-xs">Burada henüz mesaj yok. Diğer klasörlere göz atın.</p>
            </div>
        }
        else
        {
            @foreach (var msg in Model)
            {
                var displayName = msg.Sender != null ? $"{msg.Sender.Name} {msg.Sender.Surname}" : "Bilinmeyen";
                <div class="group relative bg-white hover:bg-white/60 p-md rounded-xl shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_8px_30px_rgba(0,0,0,0.06)] border border-transparent hover:border-white/50 transition-all flex items-center gap-md cursor-pointer active:scale-[0.99] @(!msg.IsRead ? "bg-primary/[0.03]" : "")" data-id="@msg.Id" onclick="openMessage(event, @msg.Id)">
                    <div class="flex items-center gap-sm" onclick="event.stopPropagation()">
                        <input type="checkbox" class="msg-checkbox rounded text-primary focus:ring-primary/20 border-outline-variant/30" onchange="updateBulkActions()">
                        <button class="star-btn text-outline hover:text-tertiary transition-colors" data-id="@msg.Id" onclick="toggleStar(event, @msg.Id, this)">
                            <span class="material-symbols-outlined text-[20px] @(msg.IsStarred ? "text-tertiary" : "")" style="@(msg.IsStarred ? "font-variation-settings: 'FILL' 1;" : "")">star</span>
                        </button>
                    </div>

                    @if (!msg.IsRead)
                    {
                        <span class="w-2 h-2 rounded-full bg-primary shrink-0"></span>
                    }
                    else
                    {
                        <span class="w-2 h-2 shrink-0"></span>
                    }

                    <div class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center font-bold text-primary border border-outline-variant/20">
                        @displayName.Substring(0, 1)
                    </div>
                    <div class="flex-1 min-w-0 grid grid-cols-12 gap-md items-center">
                        <div class="col-span-3">
                            <p class="font-title-lg text-sm text-on-surface truncate @(!msg.IsRead ? "font-bold" : "")">@displayName</p>
                        </div>
                        <div class="col-span-7">
                            <div class="flex items-center gap-sm">
                                @if (msg.Category != null)
                                {
                                    <span class="bg-@(msg.Category.Color)/10 text-@(msg.Category.Color) text-[10px] font-bold px-sm py-xs rounded-md">@msg.Category.Name</span>
                                }
                                <p class="font-body-md text-sm text-on-surface truncate max-w-[400px] @(!msg.IsRead ? "font-bold" : "")">
                                    <span class="font-bold">@msg.Subject</span>
                                    <span class="text-outline font-normal"> — @msg.Body</span>
                                </p>
                            </div>
                        </div>
                        <div class="col-span-2 text-right">
                            <p class="text-[12px] text-outline">@msg.SentAt.ToString("dd MMM, HH:mm")</p>
                        </div>
                    </div>

                    <div class="absolute right-md top-1/2 -translate-y-1/2 hidden group-hover:flex items-center gap-xs bg-white/90 p-xs rounded-lg shadow-sm border border-outline-variant/20" onclick="event.stopPropagation()">
                        <button onclick="toggleRead(@msg.Id, this)" data-read="@msg.IsRead.ToString().ToLower()" class="p-xs text-on-surface-variant hover:text-primary transition-colors" title="@(msg.IsRead ? "Okunmadı işaretle" : "Okundu işaretle")">
                            <span class="material-symbols-outlined text-[20px]">@(msg.IsRead ? "mark_email_unread" : "mark_email_read")</span>
                        </button>
                    </div>
                </div>
            }
        }
    </div>
</main>

@section Scripts {
    <script>
        function toggleStar(event, id, btn) {
            event.stopPropagation();
            fetch('/Message/ToggleStar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'id=' + id
            })
            .then(res => res.json())
            .then(data => {
                const icon = btn.querySelector('span');
                if (data.isStarred) {
                    icon.classList.add('text-tertiary');
                    icon.style.fontVariationSettings = "'FILL' 1";
                } else {
                    icon.classList.remove('text-tertiary');
                    icon.style.fontVariationSettings = "'FILL' 0";
                }
            });
        }

        function openMessage(event, id) {
            window.location.href = '/Message/Detail/' + id;
        }

        function updateBulkActions() {
            const checked = document.querySelectorAll('.msg-checkbox:checked');
            const count = checked.length;
            const archiveBtn = document.getElementById('archiveBtn');
            const deleteBtn = document.getElementById('deleteBtn');
            const reportBtn = document.getElementById('reportBtn');
            const countLabel = document.getElementById('selectionCount');

            const isActive = count > 0;
            [archiveBtn, deleteBtn, reportBtn].forEach(btn => {
                btn.disabled = !isActive;
                if (isActive) {
                    btn.classList.remove('text-outline-variant', 'cursor-not-allowed');
                    btn.classList.add('text-on-surface-variant', 'hover:bg-surface-container');
                } else {
                    btn.classList.add('text-outline-variant', 'cursor-not-allowed');
                    btn.classList.remove('text-on-surface-variant', 'hover:bg-surface-container');
                }
            });
            deleteBtn.classList.toggle('hover:bg-error-container/20', isActive);
            deleteBtn.classList.toggle('text-error', isActive);

            countLabel.textContent = isActive ? count + ' seçili' : '';
        }

        function getSelectedIds() {
            return Array.from(document.querySelectorAll('.msg-checkbox:checked'))
                .map(cb => cb.closest('[data-id]').dataset.id);
        }

        function bulkDelete() {
            const ids = getSelectedIds();
            if (ids.length === 0) return;

            const confirmed = confirm(ids.length + ' mesajı çöp kutusuna taşımak istediğinize emin misiniz?');
            if (!confirmed) return;

            Promise.all(ids.map(id =>
                fetch('/Message/DeleteMessage', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'id=' + id
                })
            )).then(() => location.reload());
        }

        function bulkArchive() {
            const ids = getSelectedIds();
            if (ids.length === 0) return;

            const confirmed = confirm(ids.length + ' mesajı arşivlemek istediğinize emin misiniz?');
            if (!confirmed) return;

            Promise.all(ids.map(id =>
                fetch('/Message/ArchiveMessage', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'id=' + id
                })
            )).then(() => location.reload());
        }
                document.getElementById('filterBtn').addEventListener('click', (e) => {
            e.stopPropagation();
            document.getElementById('filterDropdown').classList.toggle('hidden');
        });

        document.addEventListener('click', () => {
            document.getElementById('filterDropdown').classList.add('hidden');
        });

        document.getElementById('filterDropdown').addEventListener('click', (e) => {
            e.stopPropagation();
        });

        function applyFilters() {
            const isRead = document.querySelector('input[name="isRead"]:checked').value;
            const starred = document.getElementById('starredFilter').checked;
            const categoryId = document.getElementById('categoryFilter').value;

            const params = new URLSearchParams();
            if (isRead) params.set('isRead', isRead);
            if (starred) params.set('starred', 'true');
            if (categoryId) params.set('categoryId', categoryId);

            window.location.search = params.toString();
        }
    </script>
}