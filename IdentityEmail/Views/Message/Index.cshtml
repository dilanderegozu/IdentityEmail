@{
    ViewData["Title"] = "Mesajlar";
    Layout = "_MessageLayout";
}

<main class="flex-1 flex flex-col bg-surface overflow-visible relative">
    <div class="h-16 flex items-center justify-between px-md border-b border-outline-variant/20 bg-white/40 glass" id="dynamic-toolbar">
        <div class="flex items-center gap-md">
            <h2 class="font-headline-md text-headline-md text-on-surface-variant" id="folder-title">Gelen Kutusu</h2>
            <div class="flex items-center gap-xs ml-md">
                <button class="p-sm text-on-surface-variant hover:bg-surface-container rounded-lg transition-all" title="Arşivle">
                    <span class="material-symbols-outlined text-[20px]">archive</span>
                </button>
                <button class="p-sm text-on-surface-variant hover:bg-surface-container rounded-lg transition-all" title="Bildir">
                    <span class="material-symbols-outlined text-[20px]">report</span>
                </button>
                <button class="p-sm text-error hover:bg-error-container/20 rounded-lg transition-all" title="Sil">
                    <span class="material-symbols-outlined text-[20px]">delete</span>
                </button>
            </div>
        </div>
        <div class="flex items-center gap-sm">
            <button class="flex items-center gap-xs px-md py-xs bg-surface-container-high text-on-surface font-label-md text-label-md rounded-lg hover:bg-surface-container-highest transition-all">
                <span class="material-symbols-outlined text-[18px]">sort</span>
                Filtrele
            </button>
            <div class="flex items-center text-on-surface-variant text-label-md px-sm">1-50 / 1.248</div>
            <div class="flex border border-outline-variant/30 rounded-lg overflow-hidden">
                <button class="p-xs hover:bg-surface-container-high border-r border-outline-variant/30">
                    <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                </button>
                <button class="p-xs hover:bg-surface-container-high">
                    <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                </button>
            </div>
        </div>
    </div>
    <div class="flex-1 overflow-y-auto p-md space-y-sm" id="content-container"></div>
</main>

@section Scripts {
    <script>
        const folders = [
            { id: 'inbox',     label: 'Gelen Kutusu', icon: 'inbox',    unread: 24, active: true },
            { id: 'starred',  label: 'Yıldızlı',      icon: 'star',     unread: 0 },
            { id: 'drafts',   label: 'Taslaklar',     icon: 'draft',    unread: 3 },
            { id: 'sent',     label: 'Gönderilmiş',   icon: 'send',     unread: 0 },
            { id: 'scheduled',label: 'Planlanmış',    icon: 'schedule', unread: 1 },
            { id: 'archived', label: 'Arşivlenmiş',   icon: 'archive',  unread: 0 },
            { id: 'spam',     label: 'Spam',          icon: 'report',   unread: 12 },
            { id: 'trash',    label: 'Çöp Kutusu',    icon: 'delete',   unread: 0 },
        ];

        const labels = [
            { id: 'lbl-work',     label: 'İş',       color: 'bg-secondary', textColor: 'text-secondary', count: 12 },
            { id: 'lbl-school',   label: 'Okul',     color: 'bg-primary',   textColor: 'text-primary',   count: 7 },
            { id: 'lbl-personal', label: 'Kişisel',  color: 'bg-tertiary',  textColor: 'text-tertiary',  count: 4 },
            { id: 'lbl-finance',  label: 'Finans',   color: 'bg-error',     textColor: 'text-error',     count: 3 },
            { id: 'lbl-travel',   label: 'Seyahat',  color: 'bg-[#1D9E75]', textColor: 'text-[#0F6E56]', count: 2 },
        ];

        const mockData = {
            inbox: [
                { id:1, sender:"Alex Riviera", subject:"Q4 Strateji Önerisi", snippet:"Q4 stratejisinin ilk taslağı incelemeye hazır. Odak noktam...", date:"10:42", category:"İş", starred:true },
                { id:2, sender:"Slack Bildirimleri", subject:"#design-system'de yeni bahsedenler", snippet:"Sarah Jenks sizi etiketledi: Hey @@Alex, şuna bakabilir misin...", date:"09:15", category:"İş", starred:false },
                { id:3, sender:"Linear", subject:"NX-452 güncellendi", snippet:"'Dashboard boşluk düzenleme' görevi Marcus Au tarafından Tamamlandı...", date:"Dün", category:"İş", starred:false },
                { id:4, sender:"Dribbble", subject:"Çalışmanız trend oldu!", snippet:"Tebrikler! 'Glassmorphic Messaging' projeniz şu an...", date:"12 Eki", category:"Kişisel", starred:true },
                { id:5, sender:"Stripe", subject:"Ödeme alındı: ₺149,00", snippet:"Merhaba, aylık plan ödemenizdeki onay için...", date:"11 Eki", category:"Finans", starred:false },
            ],
            drafts: [
                { id:101, sender:"Kime: Elena Gilbert", subject:"Re: Proje Senkronizasyonu", snippet:"Merhaba Elena, bütçe rakamlarına baktım ve...", date:"2dk önce kaydedildi", category:"İş", starred:false },
            ],
            trash: [
                { id:201, sender:"Bülten Botu", subject:"Sonraki alışverişinizde %30 indirim", snippet:"Bu Pazar gece yarısı sona eren sınırlı teklifimizi kaçırmayın...", date:"5 Eki", category:"Diğer", starred:false },
            ],
            starred: [
                { id:1, sender:"Alex Riviera", subject:"Q4 Strateji Önerisi", snippet:"Q4 stratejisinin ilk taslağı incelemeye hazır...", date:"10:42", category:"İş", starred:true },
                { id:4, sender:"Dribbble", subject:"Çalışmanız trend oldu!", snippet:"Tebrikler! Projeniz şu an trend listesinde...", date:"12 Eki", category:"Kişisel", starred:true },
            ],
            archived: [
                { id:301, sender:"Google Workspace", subject:"Depolama alanı raporu", snippet:"Ocak ayı depolama alanı raporunuz hazır. Toplam kullanım...", date:"3 Eki", category:"İş", starred:false },
            ],
            scheduled: [
                { id:401, sender:"Taslak → Müşteri A", subject:"Proje Durum Güncellemesi", snippet:"Merhaba, bu hafta tamamlanan kilometre taşlarını paylaşmak istedim...", date:"Yarın 09:00", category:"İş", starred:false },
            ],
            'lbl-work': [
                { id:1, sender:"Alex Riviera", subject:"Q4 Strateji Önerisi", snippet:"Q4 stratejisinin ilk taslağı incelemeye hazır...", date:"10:42", category:"İş", starred:true },
                { id:3, sender:"Linear", subject:"NX-452 güncellendi", snippet:"'Dashboard boşluk düzenleme' görevi tamamlandı...", date:"Dün", category:"İş", starred:false },
            ],
            'lbl-school': [
                { id:501, sender:"Üniversite Portalı", subject:"Dönem sonu sınav programı", snippet:"2024-2025 bahar dönemi sınav takvimi yayınlandı...", date:"9 Eki", category:"Okul", starred:false },
                { id:502, sender:"Prof. Dr. Yılmaz", subject:"Ödev teslim tarihi hakkında", snippet:"Grup ödevinin teslim tarihi 20 Ekim olarak uzatılmıştır...", date:"8 Eki", category:"Okul", starred:true },
            ],
            'lbl-personal': [
                { id:4, sender:"Dribbble", subject:"Çalışmanız trend oldu!", snippet:"Tebrikler! Projeniz şu an trend listesinde...", date:"12 Eki", category:"Kişisel", starred:true },
            ],
            'lbl-finance': [
                { id:5, sender:"Stripe", subject:"Ödeme alındı: ₺149,00", snippet:"Aylık plan ödemenizdeki onay...", date:"11 Eki", category:"Finans", starred:false },
            ],
            'lbl-travel': [],
        };

        const navContainer = document.getElementById('folder-nav');
        const labelContainer = document.getElementById('label-nav');
        const contentContainer = document.getElementById('content-container');
        const toolbar = document.getElementById('dynamic-toolbar');
        let activeId = 'inbox';

        function renderNav() {
            if (!navContainer || !labelContainer) return;
            navContainer.innerHTML = folders.map(f => `
                <button onclick="switchView('${f.id}', '${f.label}')" class="flex items-center justify-between w-full p-sm transition-all group ${activeId === f.id ? 'bg-gradient-to-r from-primary/10 to-secondary/10 text-primary font-semibold rounded-xl' : 'text-on-surface-variant hover:bg-surface-container-highest/50 rounded-xl'}">
                    <div class="flex items-center gap-sm">
                        <span class="material-symbols-outlined text-[22px] ${activeId === f.id ? 'text-primary' : 'text-outline'} group-hover:text-primary transition-colors">${f.icon}</span>
                        <span class="font-label-md text-label-md">${f.label}</span>
                    </div>
                    ${f.unread > 0 ? `<span class="bg-primary/10 text-primary text-[10px] px-sm py-xs rounded-full min-w-[24px] text-center">${f.unread}</span>` : ''}
                </button>
            `).join('');

            labelContainer.innerHTML = labels.map(l => `
                <button onclick="switchView('${l.id}', '${l.label}')" class="flex items-center justify-between w-full p-sm transition-all ${activeId === l.id ? 'bg-gradient-to-r from-primary/10 to-secondary/10 rounded-xl' : 'hover:bg-surface-container-highest/50 rounded-xl'}">
                    <div class="flex items-center gap-sm">
                        <span class="w-2.5 h-2.5 rounded-full ${l.color} flex-shrink-0"></span>
                        <span class="font-label-md text-label-md ${activeId === l.id ? l.textColor + ' font-semibold' : 'text-on-surface-variant'}">${l.label}</span>
                    </div>
                    <span class="text-[10px] ${l.color}/10 ${l.textColor} px-xs rounded font-bold">${l.count}</span>
                </button>
            `).join('');
        }

        function switchView(id, label) {
            activeId = id;
            renderNav();
            renderContent(id, label);
            updateToolbar(id, label);
        }

        function updateToolbar(id, label) {
            let actionsHtml = '';
            if (id === 'trash') {
                actionsHtml = `
                    <button class="flex items-center gap-xs px-md py-xs bg-primary text-white font-label-md text-label-md rounded-lg hover:shadow-lg transition-all">
                        <span class="material-symbols-outlined text-[18px]">restore</span> Tümünü Geri Al
                    </button>
                    <button class="flex items-center gap-xs px-md py-xs bg-error text-white font-label-md text-label-md rounded-lg hover:shadow-lg transition-all">
                        <span class="material-symbols-outlined text-[18px]">delete_forever</span> Çöpü Boşalt
                    </button>`;
            } else if (id === 'drafts') {
                actionsHtml = `
                    <button class="flex items-center gap-xs px-md py-xs bg-primary text-white font-label-md text-label-md rounded-lg hover:shadow-lg transition-all">
                        <span class="material-symbols-outlined text-[18px]">edit</span> Düzenlemeye Devam Et
                    </button>`;
            } else {
                actionsHtml = `
                    <div class="flex items-center gap-xs ml-md">
                        <button class="p-sm text-on-surface-variant hover:bg-surface-container rounded-lg transition-all" title="Arşivle">
                            <span class="material-symbols-outlined text-[20px]">archive</span>
                        </button>
                        <button class="p-sm text-on-surface-variant hover:bg-surface-container rounded-lg transition-all" title="Bildir">
                            <span class="material-symbols-outlined text-[20px]">report</span>
                        </button>
                        <button class="p-sm text-error hover:bg-error-container/20 rounded-lg transition-all" title="Sil">
                            <span class="material-symbols-outlined text-[20px]">delete</span>
                        </button>
                    </div>`;
            }
            toolbar.querySelector('.flex.items-center.gap-md').innerHTML = `
                <h2 id="folder-title" class="font-headline-md text-headline-md text-on-surface-variant">${label}</h2>
                ${actionsHtml}
            `;
        }

        function renderContent(id, label) {
            const data = mockData[id] || [];
            if (data.length === 0) {
                contentContainer.innerHTML = `
                    <div class="flex flex-col items-center justify-center h-full py-xl text-center">
                        <div class="w-24 h-24 mb-lg rounded-full bg-surface-container flex items-center justify-center">
                            <span class="material-symbols-outlined text-[48px] text-outline">inbox</span>
                        </div>
                        <h3 class="font-headline-md text-on-surface-variant mb-xs">${label} boş</h3>
                        <p class="text-outline font-body-md max-w-xs">Burada henüz mesaj yok. Diğer klasörlere göz atın.</p>
                    </div>`;
                return;
            }

            const catColorMap = { 'İş': 'secondary', 'Kişisel': 'tertiary', 'Finans': 'error', 'Okul': 'primary', 'Diğer': 'primary' };

            contentContainer.innerHTML = data.map(msg => {
                const cat = catColorMap[msg.category] || 'primary';
                return `
                <div class="group relative bg-white hover:bg-white/60 p-md rounded-xl shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_8px_30px_rgba(0,0,0,0.06)] border border-transparent hover:border-white/50 transition-all flex items-center gap-md cursor-pointer active:scale-[0.99]">
                    <div class="flex items-center gap-sm">
                        <input type="checkbox" class="rounded text-primary focus:ring-primary/20 border-outline-variant/30">
                        <button class="text-outline hover:text-tertiary transition-colors">
                            <span class="material-symbols-outlined text-[20px] ${msg.starred ? 'text-tertiary' : ''}" ${msg.starred ? 'style="font-variation-settings: \'FILL\' 1;"' : ''}>star</span>
                        </button>
                    </div>
                    <div class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center font-bold text-primary border border-outline-variant/20">
                        ${msg.sender.charAt(0)}
                    </div>
                    <div class="flex-1 min-w-0 grid grid-cols-12 gap-md items-center">
                        <div class="col-span-3">
                            <p class="font-title-lg text-sm text-on-surface truncate">${msg.sender}</p>
                        </div>
                        <div class="col-span-7">
                            <div class="flex items-center gap-sm">
                                <span class="bg-${cat}/10 text-${cat} text-[10px] font-bold px-sm py-xs rounded-md">${msg.category}</span>
                                <p class="font-body-md text-sm text-on-surface truncate max-w-[400px]">
                                    <span class="font-bold">${msg.subject}</span>
                                    <span class="text-outline"> — ${msg.snippet}</span>
                                </p>
                            </div>
                        </div>
                        <div class="col-span-2 text-right">
                            <p class="text-[12px] text-outline">${msg.date}</p>
                        </div>
                    </div>
                    <div class="absolute right-md top-1/2 -translate-y-1/2 hidden group-hover:flex items-center gap-xs bg-white/90 glass p-xs rounded-lg shadow-sm border border-outline-variant/20">
                        <button class="p-xs text-on-surface-variant hover:text-primary transition-colors">
                            <span class="material-symbols-outlined text-[20px]">archive</span>
                        </button>
                        <button class="p-xs text-error transition-colors">
                            <span class="material-symbols-outlined text-[20px]">delete</span>
                        </button>
                        <button class="p-xs text-on-surface-variant hover:text-primary transition-colors">
                            <span class="material-symbols-outlined text-[20px]">mark_as_unread</span>
                        </button>
                        <button class="p-xs text-on-surface-variant hover:text-primary transition-colors">
                            <span class="material-symbols-outlined text-[20px]">schedule</span>
                        </button>
                    </div>
                </div>`;
            }).join('');
        }

        renderNav();
        renderContent('inbox', 'Gelen Kutusu');

        document.getElementById('notifBtn')?.addEventListener('click', (e) => {
            e.stopPropagation();
            document.getElementById('notifDropdown').classList.toggle('hidden');
            document.getElementById('profileDropdown').classList.add('hidden');
        });

        document.getElementById('profileBtn')?.addEventListener('click', (e) => {
            e.stopPropagation();
            document.getElementById('profileDropdown').classList.toggle('hidden');
            document.getElementById('notifDropdown').classList.add('hidden');
        });

        document.addEventListener('click', () => {
            document.getElementById('notifDropdown')?.classList.add('hidden');
            document.getElementById('profileDropdown')?.classList.add('hidden');
        });
    </script>
}