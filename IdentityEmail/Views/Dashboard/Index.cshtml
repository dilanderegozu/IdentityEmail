@{
    ViewData["Title"] = "Ana Sayfa";
    Layout = "_DashboardLayout";
}


<main class="max-w-container-max mx-auto px-md py-xl space-y-xl">
    <!-- Header Section -->
    <section class="space-y-xs">
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Hoş Geldiniz, @User.Identity.Name.ToUpper()</h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant">Kurumsal e-posta yönetim sisteminizin güncel durumunu görüntüleyin.</p>
    </section>
    <section class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
   
        <div class="bg-white rounded-xl p-md shadow-[0px_4px_20px_rgba(0,0,0,0.03)] flex flex-col justify-between h-[180px]">
            <div class="flex justify-between items-start">
                <div>
                    <p class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Toplam Kullanıcı</p>
                    <h2 class="font-headline-md text-headline-md text-on-surface mt-xs">@ViewBag.TotalUsers</h2>
                </div>
                @{
                    var percent = (double)ViewBag.UserChangePercent;
                    var isPositive = percent >= 0;
                }
                <span class="@(isPositive ? "bg-primary/10 text-primary" : "bg-error/10 text-error") px-xs py-1 rounded text-[10px] font-bold">
                    @(isPositive ? "+" : "")@percent%
                </span>
            </div>
            <div class="h-16 w-full flex items-end gap-1">
                @{
                    var userHeights = ViewBag.DailyHeights as List<int>;
                    var userCounts = ViewBag.DailyCounts as List<int>;
                    var dayNames = new[] { "Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Paz" };
                }
                @for (int i = 0; i < userHeights.Count; i++)
                {
                    var height = userHeights[i];
                    var count = userCounts[i];
                    var isMax = height == 100;
                    var displayHeight = height == 0 ? 4 : height;
                    <div class="relative w-full group flex flex-col items-center justify-end h-full">
                        <div class="absolute bottom-full mb-1 hidden group-hover:flex flex-col items-center z-10">
                            <div class="bg-on-surface text-surface text-[10px] font-bold px-xs py-1 rounded whitespace-nowrap">
                                @count kayıt
                            </div>
                            <div class="w-0 h-0 border-l-4 border-r-4 border-t-4 border-l-transparent border-r-transparent border-t-on-surface"></div>
                        </div>
                        <div class="w-full rounded-t-sm @(isMax ? "bg-primary" : "bg-primary/10") transition-all"
                             style="height: @displayHeight%">
                        </div>
                    </div>
                }
            </div>
            <div class="flex justify-between gap-1 text-[9px] text-outline-variant mt-1">
                <span>Pzt</span><span>Sal</span><span>Çar</span><span>Per</span><span>Cum</span><span>Cmt</span><span>Paz</span>
            </div>
        </div>
        <div class="bg-white rounded-xl p-md shadow-[0px_4px_20px_rgba(0,0,0,0.03)] flex flex-col justify-between h-[180px]">
            <div class="flex justify-between items-start">
                <div>
                    <p class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Okunmamış Mesajlar</p>
                    <h2 class="font-headline-md text-headline-md text-on-surface mt-xs">@ViewBag.UnreadMessages</h2>
                </div>
                @{
                    var unreadPercent = (double)ViewBag.UnreadChangePercent;
                    var unreadPositive = unreadPercent >= 0;
                }
                <span class="@(unreadPositive ? "bg-secondary/10 text-secondary" : "bg-error/10 text-error") px-xs py-1 rounded text-[10px] font-bold">
                    @(unreadPositive ? "+" : "")@unreadPercent%
                </span>
            </div>
            <div class="h-16 w-full flex items-end gap-1">
                @{
                    var unreadHeightsList = ViewBag.UnreadHeights as List<int>;
                    var unreadCountsList = ViewBag.UnreadCounts as List<int>;
                }
                @for (int i = 0; i < unreadHeightsList.Count; i++)
                {
                    var height = unreadHeightsList[i];
                    var count = unreadCountsList[i];
                    var isMax = height == 100;
                    var displayHeight = height == 0 ? 4 : height;
                    <div class="relative w-full group flex flex-col items-center justify-end h-full">
                        <div class="absolute bottom-full mb-1 hidden group-hover:flex flex-col items-center z-10">
                            <div class="bg-on-surface text-surface text-[10px] font-bold px-xs py-1 rounded whitespace-nowrap">
                                @count mesaj
                            </div>
                            <div class="w-0 h-0 border-l-4 border-r-4 border-t-4 border-l-transparent border-r-transparent border-t-on-surface"></div>
                        </div>
                        <div class="w-full rounded-t-sm @(isMax ? "bg-secondary" : "bg-secondary/10") transition-all"
                             style="height: @displayHeight%">
                        </div>
                    </div>
                }
            </div>
            <div class="flex justify-between gap-1 text-[9px] text-outline-variant mt-1">
                <span>Pzt</span><span>Sal</span><span>Çar</span><span>Per</span><span>Cum</span><span>Cmt</span><span>Paz</span>
            </div>
        </div>
    
        <div class="bg-white rounded-xl p-md shadow-[0px_4px_20px_rgba(0,0,0,0.03)] flex flex-col justify-between h-[180px]">
            <div class="flex justify-between items-start">
                <div>
                    <p class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Bugün Gönderilen E-Posta Sayısı</p>
                    <h2 class="font-headline-md text-headline-md text-on-surface mt-xs">@ViewBag.TodaySent</h2>
                </div>
                @{
                    var sentPercent = (double)ViewBag.SentChangePercent;
                    var sentPositive = sentPercent >= 0;
                }
                <span class="@(sentPositive ? "bg-tertiary-container text-on-tertiary-fixed-variant" : "bg-error/10 text-error") px-xs py-1 rounded text-[10px] font-bold">
                    @(sentPositive ? "+" : "")@sentPercent%
                </span>
            </div>
            <div class="h-16 w-full flex items-end gap-1">
                @{
                    var sentHeightsList = ViewBag.SentHeights as List<int>;
                    var sentCountsList = ViewBag.SentCounts as List<int>;
                }
                @for (int i = 0; i < sentHeightsList.Count; i++)
                {
                    var height = sentHeightsList[i];
                    var count = sentCountsList[i];
                    var isMax = height == 100;
                    var displayHeight = height == 0 ? 4 : height;
                    <div class="relative w-full group flex flex-col items-center justify-end h-full">
                        <div class="absolute bottom-full mb-1 hidden group-hover:flex flex-col items-center z-10">
                            <div class="bg-on-surface text-surface text-[10px] font-bold px-xs py-1 rounded whitespace-nowrap">
                                @count e-posta
                            </div>
                            <div class="w-0 h-0 border-l-4 border-r-4 border-t-4 border-l-transparent border-r-transparent border-t-on-surface"></div>
                        </div>
                        <div class="w-full rounded-t-sm @(isMax ? "bg-tertiary" : "bg-tertiary/10") transition-all"
                             style="height: @displayHeight%">
                        </div>
                    </div>
                }

            </div>
            <div class="flex justify-between gap-1 text-[9px] text-outline-variant mt-1">
                <span>Pzt</span><span>Sal</span><span>Çar</span><span>Per</span><span>Cum</span><span>Cmt</span><span>Paz</span>
            </div>
        </div>
    </section>
    <!-- Analytics & Conversation Grid -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
        <!-- Message Analytics Chart -->
        <div class="lg:col-span-8 bg-white rounded-xl p-md shadow-[0px_4px_20px_rgba(0,0,0,0.03)] space-y-md">
            <div class="flex justify-between items-center">
                <h3 class="font-title-lg text-title-lg text-on-surface">E-Posta Trafik Analizi</h3>
                <div class="flex gap-sm">
                    <button id="weeklyBtn" class="px-sm py-1 rounded-full bg-surface-container text-primary font-label-md">Günlük</button>
                    <button id="monthlyBtn" class="px-sm py-1 rounded-full hover:bg-surface-container transition-colors font-label-md">Aylık</button>
                </div>
            </div>
            <div class="relative h-[300px] w-full mt-lg">
                <canvas id="trafficChart"></canvas>
            </div>
        </div>

      @await Component.InvokeAsync("DashboardStatic")
    </section>
   @await Component.InvokeAsync("DashboardData")
</main>

<!-- FAB (Contextual for Dashboard) -->
<button class="fixed bottom-lg right-lg h-14 w-14 rounded-full bg-primary text-white shadow-xl flex items-center justify-center hover:scale-110 active:scale-95 transition-all z-40 group">
    <span class="material-symbols-outlined text-2xl group-hover:rotate-90 transition-transform">add</span>
</button>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>

        // Micro-interactions and subtle effects
        document.querySelectorAll('.bg-white').forEach(card => {
        card.addEventListener('mouseenter', () => {
        card.style.transform = 'translateY(-4px)';
        card.style.transition = 'all 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
        card.style.boxShadow = '0px 8px 30px rgba(0, 0, 0, 0.06)';
        });
        card.addEventListener('mouseleave', () => {
        card.style.transform = 'translateY(0)';
        card.style.boxShadow = '0px 4px 20px rgba(0, 0, 0, 0.03)';
        });
        });
        const weeklyData = @Html.Raw(Json.Serialize(ViewBag.WeeklyMessageCounts));
        const monthlyData = @Html.Raw(Json.Serialize(ViewBag.MonthlyMessageCounts));
        const weeklyLabels = ['Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cmt', 'Paz'];
        const monthlyLabels = @Html.Raw(Json.Serialize(ViewBag.MonthlyLabels));

        const ctx = document.getElementById('trafficChart');
        const trafficChart = new Chart(ctx, {
        type: 'line',
        data: {
        labels: weeklyLabels,
        datasets: [{
        label: 'Mesaj Sayısı',
        data: weeklyData,
        borderColor: '#7f30c5',
        backgroundColor: 'rgba(127, 48, 197, 0.1)',
        borderWidth: 3,
        fill: true,
        tension: 0.4,
        pointRadius: 4,
        pointBackgroundColor: '#7f30c5',
        pointBorderColor: '#ffffff',
        pointBorderWidth: 2
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
        y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: 'rgba(0,0,0,0.05)' } },
        x: { grid: { display: false } }
        }
        }
        });

        const weeklyBtn = document.getElementById('weeklyBtn');
        const monthlyBtn = document.getElementById('monthlyBtn');

        weeklyBtn.addEventListener('click', () => {
        trafficChart.data.labels = weeklyLabels;
        trafficChart.data.datasets[0].data = weeklyData;
        trafficChart.update();
        weeklyBtn.classList.add('bg-surface-container', 'text-primary');
        monthlyBtn.classList.remove('bg-surface-container', 'text-primary');
        });

        monthlyBtn.addEventListener('click', () => {
        trafficChart.data.labels = monthlyLabels;
        trafficChart.data.datasets[0].data = monthlyData;
        trafficChart.update();
        monthlyBtn.classList.add('bg-surface-container', 'text-primary');
        weeklyBtn.classList.remove('bg-surface-container', 'text-primary');
        });
    </script>
}